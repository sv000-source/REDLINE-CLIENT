{
  "name": "happ-redline-desktop",
  "version": "1.8.1-beta",
  "description": "RED TEAM Windows-клиент с Xray и Flowseal DPI Shield для YouTube/Discord",
  "main": "src/main.js",
  "author": "Local Operator",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node --test test/*.test.js",
    "fetch:xray": "node scripts/fetch-xray.js",
    "fetch:singbox": "node scripts/fetch-singbox.js",
    "fetch:zapret": "node scripts/fetch-zapret.js",
    "prepare:engines": "node scripts/fetch-xray.js && node scripts/fetch-singbox.js && node scripts/fetch-zapret.js",
    "pack:win": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "43.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.redline.client",
    "productName": "REDLINE Client",
    "asar": true,
    "compression": "normal",
    "electronLanguages": ["en-US", "ru"],
    "protocols": [
      {
        "name": "REDLINE Subscription Import",
        "schemes": ["redline"]
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      { "from": "vendor/xray/windows-x64", "to": "xray" },
      { "from": "vendor/sing-box/windows-x64", "to": "sing-box" },
      { "from": "vendor/zapret/windows-x64", "to": "zapret" }
    ],
    "win": {
      "target": [{ "target": "dir", "arch": ["x64"] }],
      "requestedExecutionLevel": "requireAdministrator"
    }
  }
}
